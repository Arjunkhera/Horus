{
  "name": "@horus/anvil-router",
  "version": "0.1.0",
  "description": "Anvil Router — per-user Anvil tenancy routing proxy for the Horus platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@horus/auth": "workspace:*",
    "@horus/router-core": "workspace:*",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "node-sqlite3-wasm": "^0.8.53"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "jose": "^6.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
