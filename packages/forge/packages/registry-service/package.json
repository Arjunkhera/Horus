{
  "name": "@forge/registry-service",
  "version": "0.1.0",
  "description": "Forge Remote Registry HTTP service — validated publish path for all Forge artifacts",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@forge/core": "workspace:*",
    "bcryptjs": "^2.4.3",
    "sql.js": "^1.14.1",
    "fastify": "^4.27.0",
    "@fastify/sensible": "^5.6.0",
    "semver": "^7.7.4",
    "typesense": "^1.8.2",
    "yaml": "^2.4.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/sql.js": "^1.4.9",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.7.1",
    "vitest": "^1.0.0"
  }
}
